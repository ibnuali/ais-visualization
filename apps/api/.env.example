API_KEY=replace-with-aisstream-key
# Create Better Auth users with a private provisioning script; public sign-up is disabled.
# At least 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-with-a-random-32-character-minimum-secret
# Public API origin used by Better Auth for its server configuration.
BETTER_AUTH_URL=http://localhost:3000
# Optional. Better Auth session lifetime in seconds (default: 28800 / 8 hours).
AUTH_SESSION_TTL_SECONDS=28800
# Comma-separated browser origins allowed to use the API. Add the deployed web origin.
CORS_ORIGINS=http://localhost:5299,http://127.0.0.1:5299
# Used by a direct worker process; Docker Compose sets this per regional service.
WORKER_ID=west
WORKER_CONTROL_TOKEN=replace-with-a-long-random-token
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ais_anomaly
PORT=3000
HOST=127.0.0.1
